# Ignore everything at repository root
/*

# Allow repository files
!/.gitignore
!/.env.example
!/README.md
!/AGENTS.md
!/package.json
!/package-lock.json
!/tsconfig.json

# Allow application directories
!/src/
!/web/
!/test/
!/demo/
!/docs/

# Allow Claude Code shared agents (keep local settings out)
!/.claude/
/.claude/*
!/.claude/agents/

# Dependencies and build output
node_modules/
dist/
coverage/
*.log
.DS_Store
.localized

# Secrets and local configuration
.env
.env.*
!.env.example

# Elenco prospect (dati business): fuori da git e non servito pubblicamente
web/*.xlsx
*.pem
*.key
*.p12
*.pfx
*.crt

# Runtime and temporary output
data/
.wrangler/
playwright-report/
test-results/
__pycache__/
*.tmp
*.bak
*.bak-*
*.zip

# Demo output
demo/tests/
demo/eval-output/
demo/preview-output/
demo/edit-output/
demo/projects/
demo/site-output/
demo/plan-output/
demo/sites/
demo/generated.html
demo/update-output/
