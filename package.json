{
  "name": "builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Builder di prodotti digitali per non-tecnici — Fase 0+1",
  "scripts": {
    "start": "tsx src/cli/run.ts",
    "demo:phase1": "tsx demo/phase1.ts",
    "demo:qa": "tsx demo/run-qa.ts",
    "demo:gen": "tsx demo/gen.ts",
    "demo:wiring": "tsx demo/test-build-wiring.ts",
    "demo:real": "tsx --env-file=.env demo/real.ts",
    "demo:build": "tsx --env-file=.env demo/real-build.ts",
    "demo:build-browser": "tsx --env-file=.env demo/real-build-browser.ts",
    "test:repair": "tsx demo/test-repair.ts",
    "test:eval": "tsx demo/test-eval.ts",
    "test": "tsx --test test/site.test.ts",
    "eval": "tsx --env-file=.env demo/eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
